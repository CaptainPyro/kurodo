{
  "name": "kurodo",
  "displayName": "Kurodo",
  "description": "Lightweight agentic coding assistant for VS Code",
  "version": "0.1.0",
  "publisher": "kurodo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "coding",
    "claude",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kurodo.start",
        "title": "Kurodo: Start",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kurodo.newSession",
        "title": "Kurodo: New Session"
      },
      {
        "command": "kurodo.clearSession",
        "title": "Kurodo: Clear Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kurodo",
          "title": "Kurodo",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "kurodo": [
        {
          "type": "webview",
          "id": "kurodo.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Kurodo",
      "properties": {
        "kurodo.defaultModel": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "Default model to use for conversations"
        },
        "kurodo.autoMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable Auto Mode (agent proceeds automatically for low-risk actions)"
        },
        "kurodo.effortLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "description": "Default effort/reasoning level"
        },
        "kurodo.mcpServers": {
          "type": "object",
          "default": {},
          "description": "MCP server configurations"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "kurodo.start",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
